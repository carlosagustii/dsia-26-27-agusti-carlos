# Copia este fichero a .env y rellénalo. .env NO se sube al repo (.gitignore).

# Proveedor de IA generativa: mock (por defecto, sin red) | nvidia
GENAI_PROVIDER=mock

# NVIDIA NIM (https://build.nvidia.com): crea una API key gratuita (empieza por nvapi-)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GENAI_TIMEOUT_S=30

# Rutas (opcionales; por defecto relativas a la raíz del repo)
DATA_DIR=data
MODEL_PATH=models/xg_model.joblib
REPORTS_DIR=reports

LOG_LEVEL=INFO
