# Copia este fichero a .env y rellénalo: cp .env.example .env
# .env NO se sube al repo (está en .gitignore).

# Proveedor de IA generativa: nvidia (proveedor real).
# mock es el doble de pruebas que usan los tests y el CI, sin red ni claves.
GENAI_PROVIDER=nvidia

# NVIDIA NIM (https://build.nvidia.com): crea una API key gratuita (empieza por nvapi-)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
GENAI_TIMEOUT_S=30

# URL de la API que consume el dashboard Streamlit
API_URL=http://localhost:8000

# Rutas (opcionales; por defecto relativas a la raíz del repo)
DATA_DIR=data
MODEL_PATH=models/xg_model.joblib
REPORTS_DIR=reports

LOG_LEVEL=INFO
